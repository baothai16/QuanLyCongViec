<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvThongTinSinhVien"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ho ten: Nguyen Van A\nMa SV: 2212345\nLop HP: 22CT1"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/edtTenCongViec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhap ten cong viec" />

    <EditText
        android:id="@+id/edtMoTa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhap mo ta cong viec"
        android:minLines="3" />

    <Button
        android:id="@+id/btnTaoCongViec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tao cong viec" />

    <Button
        android:id="@+id/btnXemDanhSach"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xem danh sach cong viec" />
</LinearLayout>